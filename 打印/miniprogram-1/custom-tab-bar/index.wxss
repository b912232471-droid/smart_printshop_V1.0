.tab-shell { position: fixed; left: 20rpx; right: 20rpx; bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 1000; height: 108rpx; padding: 8rpx; display: grid; grid-template-columns: repeat(4,1fr); background: rgba(255,255,255,.97); border-radius: 28rpx; box-shadow: 0 16rpx 48rpx rgba(22,48,40,.15); }
.tab-item { position: relative; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5rpx; border-radius: 21rpx; color: #89958f; transition: background .18s ease, transform .18s ease; }
.tab-item:active { transform: scale(.93); }
.tab-item.active { background: #e9f3ef; color: #176b58; }
.active-line { display: none; }
.tab-icon { width: 40rpx; height: 40rpx; opacity: .52; }
.tab-item.active .tab-icon { opacity: 1; }
.tab-text { font-size: 19rpx; line-height: 1; font-weight: 500; }
.tab-item.active .tab-text { color: #176b58; font-weight: 700; }
.tab-badge { position: absolute; top: 5rpx; right: 20rpx; min-width: 30rpx; height: 30rpx; padding: 0 7rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: #d84b4b; color: #fff; font-size: 17rpx; font-weight: 700; }
