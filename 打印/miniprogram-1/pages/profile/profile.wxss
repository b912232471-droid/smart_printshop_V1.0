.profile-page { min-height: 100vh; padding-bottom: calc(164rpx + env(safe-area-inset-bottom)); }
.account-panel { position: relative; min-height: 250rpx; margin: 22rpx 28rpx 0; padding: 32rpx 26rpx; display: flex; align-items: center; gap: 22rpx; border-radius: 32rpx; background: linear-gradient(145deg,#1b725e,#104c40); color: #fff; box-shadow: 0 18rpx 42rpx rgba(16,76,64,.2); }
.avatar-btn { position: relative; flex: 0 0 auto; }.user-avatar { width: 112rpx; height: 112rpx; display: block; border-radius: 36rpx; background: #e8efec; box-shadow: 0 0 0 6rpx rgba(255,255,255,.2); }.avatar-edit { position: absolute; right: -5rpx; bottom: -5rpx; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: #f2c94c; color: #25322e; font-size: 25rpx; font-weight: 700; }
.account-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 15rpx; }.name-row,.phone-row { display: flex; align-items: center; gap: 12rpx; }.user-name { max-width: 280rpx; font-size: 35rpx; font-weight: 720; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.edit-link { padding: 6rpx 12rpx; border-radius: 16rpx; background: rgba(255,255,255,.14); font-size: 16rpx; color: rgba(255,255,255,.78); }.phone-row { font-size: 21rpx; color: rgba(255,255,255,.66); }.row-arrow { font-size: 26rpx; }.account-id { position: absolute; right: 24rpx; top: 22rpx; padding: 5rpx 10rpx; border-radius: 14rpx; background: rgba(255,255,255,.1); font-size: 15rpx; color: rgba(255,255,255,.58); }
.profile-body { padding: 28rpx; }.section-line { margin: 40rpx 2rpx 18rpx; display: flex; align-items: center; justify-content: space-between; font-size: 29rpx; font-weight: 700; }.section-line:first-child { margin-top: 2rpx; }.section-code { font-size: 15rpx; color: #9aa59f; font-weight: 500; }
.stats-grid { padding: 10rpx; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(25,48,41,.06); }.stat-item { min-width: 0; min-height: 105rpx; padding: 14rpx 5rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; border-radius: 20rpx; }.stat-item:active { background: #f0f5f3; }.stat-highlight { background: #e3f2ec; }.stat-num { font-size: 34rpx; font-weight: 750; }.stat-label { font-size: 18rpx; color: #77847f; }
.quick-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; margin-top: 14rpx; }.quick-action { min-height: 84rpx; padding: 0 18rpx; display: grid; grid-template-columns: 34rpx 1fr auto; align-items: center; gap: 10rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(25,48,41,.05); }.action-code { font-size: 15rpx; color: #a0aaa5; }.action-name { font-size: 23rpx; font-weight: 650; }
.menu-list { padding: 4rpx 20rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(25,48,41,.06); }.menu-item { min-height: 104rpx; padding: 14rpx 0; display: grid; grid-template-columns: 60rpx minmax(0,1fr) 22rpx; align-items: center; gap: 15rpx; }.menu-item + .menu-item { box-shadow: inset 0 2rpx 0 #edf1ef; }.menu-symbol { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #e3f0eb; color: #176b58; font-size: 15rpx; font-weight: 750; }.menu-item:nth-child(2) .menu-symbol { background: #e9f0ff; color: #2867d8; }.menu-item:nth-child(3) .menu-symbol { background: #fff0e7; color: #c25e30; }.menu-item:nth-child(4) .menu-symbol { background: #f1e9f5; color: #8e4ca0; }.menu-copy { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }.menu-title { font-size: 25rpx; font-weight: 650; }.menu-desc { max-width: 100%; font-size: 19rpx; color: #84908b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.menu-arrow { font-size: 28rpx; color: #98a39e; }.danger .menu-symbol { background: #fdebea; color: #c34343; }.danger .menu-title { color: #bd3e3e; }
