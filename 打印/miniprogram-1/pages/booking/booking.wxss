.booking-page { padding-bottom: calc(182rpx + env(safe-area-inset-bottom)); }.booking-page .section-head { margin-top: 8rpx; }.info-card,.upload-card,.counter-card,.settings-card,.picker-card,.total-card { margin-bottom: 18rpx; }
.info-card { padding: 25rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-radius: 28rpx; background: linear-gradient(145deg,#1b725e,#104c40); color: #fff; box-shadow: 0 14rpx 34rpx rgba(16,76,64,.18); }.info-left { min-width: 0; display: flex; align-items: center; gap: 16rpx; }.info-emoji { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: #f2c94c; color: #26322e; font-size: 0; }.info-emoji::after { content: 'P'; font-size: 25rpx; font-weight: 750; }.info-text { min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }.info-title { font-size: 29rpx; font-weight: 700; }.info-sub { font-size: 20rpx; color: rgba(255,255,255,.7); }.info-tag { flex: 0 0 auto; padding: 9rpx 14rpx; border-radius: 18rpx; background: rgba(255,255,255,.13); font-size: 18rpx; color: #fff; }
.upload-card,.counter-card,.settings-card,.picker-card { padding: 24rpx; }.card-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }.card-title { font-size: 27rpx; font-weight: 700; }.card-tip { font-size: 19rpx; color: #89958f; text-align: right; }
.upload-empty,.upload-selected { min-height: 148rpx; display: flex; align-items: center; gap: 18rpx; padding: 22rpx; border-radius: 22rpx; background: #f1f5f3; }.upload-icon { width: 64rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #dfece7; color: #176b58; font-size: 0; }.upload-icon::after { content: '+'; font-size: 34rpx; }.upload-desc { font-size: 23rpx; line-height: 1.5; color: #64716c; }.upload-meta { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }.upload-name { max-width: 480rpx; font-size: 24rpx; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.upload-tag { font-size: 20rpx; color: #7d8984; }
.counter { display: grid; grid-template-columns: 90rpx 1fr 90rpx; align-items: center; padding: 7rpx; border-radius: 24rpx; background: #eef3f1; }.counter-btn { height: 74rpx; border-radius: 18rpx; background: #fff; color: #176b58; font-size: 36rpx; box-shadow: 0 5rpx 14rpx rgba(25,48,41,.06); }.counter-num { text-align: center; font-size: 38rpx; font-weight: 720; }
.setting-row,.picker-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.divider { height: 2rpx; background: #edf1ef; }.picker-label { font-size: 23rpx; color: #65726d; }.picker-value { min-height: 58rpx; padding: 0 15rpx; display: flex; align-items: center; gap: 12rpx; border-radius: 18rpx; background: #f1f5f3; font-size: 24rpx; font-weight: 650; }.picker-arrow { font-size: 20rpx; color: #82908a; }
.mini-counter { display: grid; grid-template-columns: 62rpx 68rpx 62rpx; align-items: center; padding: 5rpx; border-radius: 19rpx; background: #eef3f1; }.mini-btn { height: 52rpx; border-radius: 15rpx; background: #fff; color: #176b58; font-size: 27rpx; }.mini-num { text-align: center; font-size: 25rpx; font-weight: 700; }
.store-brief { padding: 16rpx; border-radius: 18rpx; background: #eef5f2; font-size: 20rpx; line-height: 1.5; color: #65726d; }.total-card { padding: 27rpx; border-radius: 28rpx; background: #fff0c7; box-shadow: 0 10rpx 28rpx rgba(133,98,13,.08); }.total-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }.total-label { font-size: 24rpx; font-weight: 650; }.total-amount { color: #9a5e00; font-size: 47rpx; line-height: 1; font-weight: 750; }.total-hint { display: block; margin-top: 12rpx; font-size: 19rpx; color: #756744; }
.submit-wrap { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 15rpx 28rpx calc(17rpx + env(safe-area-inset-bottom)); background: rgba(244,247,246,.96); }.submit-btn { width: 100%; height: 94rpx; border-radius: 24rpx; background: linear-gradient(135deg,#1b7a64,#105143); color: #fff; box-shadow: 0 13rpx 26rpx rgba(23,107,88,.2); font-size: 28rpx; font-weight: 700; }
