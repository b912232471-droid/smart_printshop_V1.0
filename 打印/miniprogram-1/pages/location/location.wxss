page { height: 100%; display: flex; flex-direction: column; overflow: hidden; }.location-page { min-height: 0; flex: 1; display: flex; flex-direction: column; background: #f4f7f6; overflow: hidden; }
.map-container { position: relative; flex: 0 0 38%; min-height: 360rpx; margin: 18rpx 22rpx 0; border-radius: 30rpx; box-shadow: 0 14rpx 36rpx rgba(25,48,41,.13); overflow: hidden; }.store-map { position: absolute; inset: 0; width: 100%; height: 100%; }.relocate-btn { position: absolute; right: 20rpx; bottom: 20rpx; width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: #176b58; color: #fff; box-shadow: 0 10rpx 24rpx rgba(23,107,88,.25); }.relocate-text { font-size: 0; }.relocate-text::after { content: '⌖'; font-size: 38rpx; }
.stores-list { min-height: 0; flex: 1; padding: 20rpx 22rpx 0; display: flex; flex-direction: column; }.search-box { position: relative; margin-bottom: 16rpx; }.search-input { width: 100%; height: 82rpx; padding: 0 90rpx 0 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(25,48,41,.06); font-size: 24rpx; }.search-icon { position: absolute; right: 22rpx; top: 27rpx; font-size: 0; }.search-icon::after { content: '搜索'; font-size: 19rpx; color: #176b58; font-weight: 650; }.list-header { display: flex; align-items: center; justify-content: space-between; padding: 2rpx 4rpx 12rpx; }.list-title { font-size: 29rpx; font-weight: 700; }.list-count { font-size: 19rpx; color: #87938e; }.scroll-list { min-height: 0; flex: 1; }
.store-card { margin: 10rpx 0 14rpx; padding: 16rpx; display: grid; grid-template-columns: 136rpx minmax(0,1fr); gap: 16rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(25,48,41,.06); }.store-card.active { background: #eef7f3; box-shadow: 0 10rpx 30rpx rgba(23,107,88,.13); }.store-image-wrapper { width: 136rpx; height: 156rpx; border-radius: 20rpx; background: #e8eeeb; overflow: hidden; }.store-image { width: 100%; height: 100%; }.store-info { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }.store-title-row { display: flex; align-items: baseline; gap: 7rpx; flex-wrap: wrap; }.store-device-code { font-size: 15rpx; color: #99a49f; }.store-name { min-width: 0; font-size: 26rpx; font-weight: 700; }.store-distance { margin-left: auto; font-size: 18rpx; color: #176b58; }.store-address { font-size: 19rpx; line-height: 1.45; color: #74817c; }.store-bottom { margin-top: auto; display: flex; align-items: flex-end; gap: 8rpx; }.service-tags { flex: 1; display: flex; flex-wrap: wrap; gap: 5rpx; }.service-tag { padding: 5rpx 9rpx; border-radius: 13rpx; background: #eef3f1; font-size: 16rpx; color: #64716c; }.store-actions { display: flex; gap: 6rpx; }.action-btn { min-width: 58rpx; height: 52rpx; padding: 0 10rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: #edf3f1; }.action-btn-primary { background: #176b58; color: #fff; }.action-icon { display: none; }.action-label { font-size: 17rpx; font-weight: 650; }.bottom-placeholder { height: calc(140rpx + env(safe-area-inset-bottom)); }
