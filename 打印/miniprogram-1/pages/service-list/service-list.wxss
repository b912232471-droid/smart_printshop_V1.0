.category-head { margin-bottom: 24rpx; padding: 28rpx 26rpx 32rpx; border-radius: 30rpx; background: linear-gradient(145deg,#1b725e,#104c40); color: #fff; box-shadow: 0 16rpx 38rpx rgba(16,76,64,.18); }
.category-index { display: block; font-size: 16rpx; color: rgba(255,255,255,.58); }.category-title { display: block; margin-top: 14rpx; font-size: 49rpx; line-height: 1.15; font-weight: 730; }.category-desc { display: block; margin-top: 13rpx; font-size: 21rpx; color: rgba(255,255,255,.72); }
.service-list { display: flex; flex-direction: column; gap: 14rpx; }
.service-row { min-height: 132rpx; padding: 20rpx 22rpx; display: grid; grid-template-columns: 44rpx minmax(0,1fr) auto 24rpx; align-items: center; gap: 14rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(25,48,41,.06); }
.service-no { align-self: start; padding-top: 15rpx; font-size: 16rpx; color: #9ba6a1; }.service-copy { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }.service-name { font-size: 28rpx; line-height: 1.25; font-weight: 680; }.service-desc { max-width: 100%; font-size: 20rpx; color: #7d8984; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.service-price { min-width: 88rpx; color: #176b58; font-size: 32rpx; font-weight: 730; text-align: right; }.currency { margin-right: 3rpx; font-size: 18rpx; }.service-arrow { color: #92a09a; font-size: 30rpx; }
