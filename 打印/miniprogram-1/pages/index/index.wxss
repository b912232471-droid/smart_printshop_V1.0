.index-shell { padding-top: 18rpx; }
.store-strip { min-height: 88rpx; display: flex; align-items: center; gap: 16rpx; padding: 10rpx 4rpx 20rpx; }
.store-pin { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #e2efe9; }
.pin-core { width: 14rpx; height: 14rpx; border-radius: 50%; background: #176b58; box-shadow: 0 0 0 7rpx rgba(23,107,88,.12); }
.store-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.eyebrow { font-size: 16rpx; color: #98a39e; }
.store-name { font-size: 25rpx; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.strip-action { padding: 12rpx 18rpx; border-radius: 22rpx; background: #fff; color: #52605b; font-size: 21rpx; }
.hero-panel { min-height: 354rpx; display: grid; grid-template-columns: minmax(0,1fr) 190rpx; margin-top: 14rpx; border-radius: 32rpx; background: linear-gradient(145deg,#1b725e,#104c40); color: #fff; box-shadow: 0 20rpx 44rpx rgba(16,76,64,.2); overflow: hidden; }
.hero-main { min-width: 0; padding: 34rpx 28rpx; }
.hero-index { display: block; margin-bottom: 34rpx; font-size: 16rpx; color: rgba(255,255,255,.58); }
.hero-title { display: block; font-size: 43rpx; line-height: 1.28; font-weight: 730; white-space: pre-line; }
.hero-note { display: block; margin-top: 25rpx; font-size: 21rpx; color: rgba(255,255,255,.75); }
.queue-block { min-width: 0; margin: 16rpx; padding: 24rpx 17rpx; display: flex; flex-direction: column; justify-content: flex-end; border-radius: 24rpx; background: #f2c94c; color: #28332f; }
.queue-number { font-size: 82rpx; line-height: .9; font-weight: 760; }
.queue-unit { margin-top: 12rpx; font-size: 20rpx; }
.queue-status { margin-top: 28rpx; display: flex; align-items: flex-start; gap: 8rpx; font-size: 18rpx; line-height: 1.35; }
.status-dot { width: 12rpx; height: 12rpx; margin-top: 5rpx; flex: 0 0 auto; border-radius: 50%; background: #268b68; }
.queue-status.busy .status-dot { background: #d85a42; }
.service-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; }
.service-tile { position: relative; min-height: 226rpx; padding: 22rpx; display: flex; flex-direction: column; justify-content: space-between; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(25,48,41,.065); }
.service-primary { background: #e4f1ec; }
.tile-code { width: 72rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #176b58; color: #fff; font-size: 24rpx; font-weight: 700; }
.photo-code { background: #2867d8; }.id-code { background: #a453b8; }.copy-code { background: #ef7a45; }
.tile-copy { display: flex; flex-direction: column; gap: 7rpx; }
.tile-title { font-size: 29rpx; font-weight: 700; }.tile-desc { font-size: 20rpx; color: #7a8782; }
.tile-arrow { position: absolute; top: 24rpx; right: 24rpx; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #f0f4f2; font-size: 24rpx; }
.tool-head { margin-top: 48rpx; }
.tool-list { padding: 4rpx 22rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(25,48,41,.055); }
.tool-row { min-height: 98rpx; display: grid; grid-template-columns: 54rpx minmax(0,1fr) auto 24rpx; align-items: center; gap: 12rpx; }
.tool-row + .tool-row { box-shadow: inset 0 2rpx 0 #edf1ef; }
.tool-no { font-size: 17rpx; color: #a0aaa5; }.tool-name { font-size: 26rpx; font-weight: 650; }.tool-meta { font-size: 20rpx; color: #8a9691; }.tool-arrow { font-size: 30rpx; color: #82908a; }
.upload-banner { margin-top: 28rpx; padding: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-radius: 28rpx; background: #27332f; color: #fff; box-shadow: 0 14rpx 34rpx rgba(24,34,31,.16); }
.upload-kicker { display: block; font-size: 15rpx; color: #94aaa1; }.upload-title { display: block; margin-top: 8rpx; font-size: 29rpx; font-weight: 700; }.upload-action { flex: 0 0 auto; padding: 14rpx 18rpx; border-radius: 20rpx; background: rgba(255,255,255,.1); font-size: 21rpx; }
