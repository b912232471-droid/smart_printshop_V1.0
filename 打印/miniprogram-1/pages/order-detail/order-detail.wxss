.status-card { padding: 34rpx 28rpx; border-radius: 30rpx; text-align: left; background: linear-gradient(145deg,#1b725e,#104c40); color: #fff; box-shadow: 0 16rpx 38rpx rgba(16,76,64,.18); }.status-emoji { display: none; }.status-title { display: block; font-size: 41rpx; font-weight: 720; }.status-desc { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.5; color: rgba(255,255,255,.72); }
.code-card,.info-card,.files-card,.total-card { margin-top: 18rpx; }.code-card { padding: 8rpx; border-radius: 28rpx; }.code-row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8rpx; }.code-row > view { min-width: 0; padding: 23rpx; border-radius: 21rpx; background: #eef4f1; }.code-row > view:last-child { background: #f5d972; }.code-row .divider { display: none; }.code-label { display: block; font-size: 18rpx; color: #75817c; }.code-value { display: block; margin-top: 8rpx; font-size: 39rpx; font-weight: 750; word-break: break-all; }.code-value.accent { color: #25312d; }
.info-card,.files-card { padding: 24rpx; }.card-title { display: block; margin-bottom: 9rpx; font-size: 27rpx; font-weight: 700; }.info-list,.file-list { display: flex; flex-direction: column; }.info-row { min-height: 76rpx; display: grid; grid-template-columns: 140rpx minmax(0,1fr); align-items: center; gap: 16rpx; }.info-row + .info-row,.file-item + .file-item { box-shadow: inset 0 2rpx 0 #edf1ef; }.info-label { font-size: 20rpx; color: #7b8782; }.info-value { min-width: 0; font-size: 22rpx; line-height: 1.45; text-align: right; word-break: break-all; }.file-item { min-height: 84rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }.file-info { min-width: 0; flex: 1; display: flex; align-items: center; gap: 12rpx; }.file-emoji { width: 40rpx; height: 48rpx; flex: 0 0 auto; border-radius: 11rpx; background: #e1eee9; font-size: 0; }.file-name { min-width: 0; font-size: 22rpx; word-break: break-all; }.file-preview { flex: 0 0 auto; font-size: 19rpx; color: #176b58; }
.total-card { padding: 27rpx; border-radius: 28rpx; background: #fff0c7; box-shadow: 0 10rpx 28rpx rgba(133,98,13,.08); }.total-row { display: flex; align-items: flex-end; justify-content: space-between; }.total-label { font-size: 23rpx; font-weight: 650; }.total-amount { color: #9a5e00; font-size: 45rpx; line-height: 1; font-weight: 750; }.actions { margin-top: 18rpx; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; }.actions button { height: 88rpx; border-radius: 22rpx; font-size: 24rpx; font-weight: 700; }.actions .ghost { background: #fff; color: #25312d; box-shadow: 0 8rpx 24rpx rgba(25,48,41,.06); }.actions .primary { background: #d84b4b; color: #fff; box-shadow: 0 10rpx 24rpx rgba(216,75,75,.16); }
