.search-card { height: 84rpx; margin-top: 2rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 12rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(25,48,41,.06); }.search-input { min-width: 0; flex: 1; font-size: 24rpx; }.search-icon { font-size: 0; }.search-icon::after { content: '搜索'; font-size: 18rpx; color: #176b58; font-weight: 650; }.clear-icon { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: #edf2f0; color: #697670; font-size: 25rpx; }
.tab-row { width: 100%; margin: 18rpx 0 8rpx; padding-bottom: 8rpx; white-space: nowrap; }.tab-pill { display: inline-flex; min-width: 110rpx; height: 62rpx; margin-right: 9rpx; padding: 0 19rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: #fff; color: #6f7c77; box-shadow: 0 5rpx 18rpx rgba(25,48,41,.045); font-size: 21rpx; }.tab-pill.active { background: #176b58; color: #fff; font-weight: 700; box-shadow: 0 8rpx 20rpx rgba(23,107,88,.18); }
.order-list { display: flex; flex-direction: column; gap: 15rpx; margin-top: 10rpx; }.order-card { position: relative; padding: 23rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 9rpx 30rpx rgba(25,48,41,.065); }.order-card::before { content: ''; position: absolute; left: 0; top: 28rpx; bottom: 28rpx; width: 7rpx; border-radius: 0 7rpx 7rpx 0; background: #176b58; }.row-top,.row-middle,.row-bottom,.row-params { display: flex; align-items: center; gap: 10rpx; }.row-top { justify-content: space-between; align-items: flex-start; }.order-meta { min-width: 0; flex: 1; display: flex; align-items: center; flex-wrap: wrap; gap: 9rpx; }.order-number { font-size: 25rpx; font-weight: 720; }.status-badge { padding: 6rpx 11rpx; border-radius: 16rpx; background: #edf2f0; font-size: 17rpx; }.status-pending { background: #fff0d8; color: #875214; }.status-processing { background: #e9f0ff; color: #2860b9; }.status-ready { background: #e1f5ec; color: #176b58; }.status-completed { background: #edf1ef; color: #596660; }.status-cancelled { background: #fde9e7; color: #b64040; }.fetch-code { width: 100%; margin-top: 5rpx; font-size: 21rpx; color: #176b58; font-weight: 700; }.order-price { flex: 0 0 auto; font-size: 33rpx; font-weight: 750; }.row-middle { margin-top: 19rpx; padding-top: 16rpx; box-shadow: inset 0 2rpx 0 #edf1ef; font-size: 21rpx; color: #6a7772; }.service-name { color: #25312d; font-weight: 650; }.appoint { margin-left: auto; text-align: right; }.row-params { margin-top: 10rpx; font-size: 19rpx; line-height: 1.45; color: #7d8984; }.row-bottom { margin-top: 12rpx; font-size: 18rpx; color: #9aa49f; }
