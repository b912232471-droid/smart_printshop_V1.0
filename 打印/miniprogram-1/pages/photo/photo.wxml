<glass-nav title="AI证件照"></glass-nav>
<view class="photo-page page-shell">
  <view class="glass-card photo-hero motion-fade-up">
    <view>
      <text class="hero-title">AI证件照</text>
      <text class="hero-sub">上传照片后生成标准证件照，或对已有证件照快速换底色。</text>
    </view>
    <view class="hero-badge">PHOTO</view>
  </view>

  <view class="mode-tabs motion-fade-up motion-delay-1">
    <view
      class="mode-tab {{mode === item.value ? 'active' : ''}}"
      wx:for="{{modeTabs}}"
      wx:key="value"
      bindtap="switchMode"
      data-mode="{{item.value}}"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="glass-card upload-card motion-fade-up motion-delay-1" bindtap="chooseImage">
    <image class="source-preview" wx:if="{{sourcePath}}" src="{{sourcePath}}" mode="aspectFill" />
    <view class="upload-empty" wx:else>
      <text class="upload-icon">＋</text>
      <text class="upload-title">选择照片</text>
      <text class="upload-desc">支持相册或拍照上传</text>
    </view>
  </view>

  <view class="glass-card option-card motion-fade-up motion-delay-2">
    <view class="field" wx:if="{{mode === 'generate'}}">
      <text class="field-label">证件照规格</text>
      <picker mode="selector" range="{{photoSizes}}" bindchange="onSizeChange">
        <view class="picker-input">{{photoSizes[sizeIndex]}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">背景颜色</text>
      <view class="color-grid">
        <view
          class="color-item {{colorIndex === index ? 'active' : ''}}"
          wx:for="{{colorOptions}}"
          wx:key="value"
          wx:for-index="index"
          bindtap="selectColor"
          data-index="{{index}}"
        >
          <view class="color-dot" style="background: {{item.value}};"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="format-row" wx:if="{{mode === 'background'}}">
      <text class="field-label">输出格式</text>
      <view class="format-tabs">
        <view class="format-tab {{outputFormat === 'png' ? 'active' : ''}}" bindtap="switchOutputFormat" data-format="png">PNG</view>
        <view class="format-tab {{outputFormat === 'jpg' ? 'active' : ''}}" bindtap="switchOutputFormat" data-format="jpg">JPG</view>
      </view>
    </view>

    <view class="field" wx:if="{{mode === 'background'}}">
      <text class="field-label">增强级别</text>
      <picker mode="selector" range="{{enhanceLevels}}" range-key="label" bindchange="onEnhanceLevelChange">
        <view class="picker-input">{{enhanceLevels[enhanceLevelIndex].label}}</view>
      </picker>
    </view>

    <view class="switch-list">
      <view class="switch-row">
        <view>
          <text class="switch-title">图像增强</text>
          <text class="switch-desc">轻量调整亮度、对比度和清晰度</text>
        </view>
        <switch checked="{{enhance}}" bindchange="onToggleEnhance" color="#4f6dff" />
      </view>
      <view class="switch-row" wx:if="{{mode === 'background'}}">
        <view>
          <text class="switch-title">渐变背景</text>
          <text class="switch-desc">生成更自然的证件照背景</text>
        </view>
        <switch checked="{{gradientBg}}" bindchange="onToggleGradient" color="#4f6dff" />
      </view>
      <view class="switch-row" wx:if="{{mode === 'background'}}">
        <view>
          <text class="switch-title">边缘平滑</text>
          <text class="switch-desc">优化发丝和肩部边缘</text>
        </view>
        <switch checked="{{smoothEdge}}" bindchange="onToggleSmooth" color="#4f6dff" />
      </view>
    </view>

    <button class="primary-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="handleProcess">
      {{loading ? '处理中...' : (mode === 'generate' ? '生成证件照' : '开始换底色')}}
    </button>
  </view>

  <view class="glass-card error-card motion-fade-up" wx:if="{{errorMsg}}">
    <text class="error-text">{{errorMsg}}</text>
  </view>

  <view class="glass-card result-card motion-fade-up" wx:if="{{resultPath}}">
    <view class="result-head">
      <view>
        <text class="result-title">处理结果</text>
        <text class="result-sub">{{resultInfo.width}}×{{resultInfo.height}} · {{resultInfo.format}}</text>
      </view>
      <text class="result-tag">{{mode === 'generate' ? resultInfo.size : '换底色'}}</text>
    </view>
    <image class="result-image" src="{{resultPath}}" mode="aspectFit" bindtap="previewResult" />
    <view class="action-row">
      <button class="secondary-btn" bindtap="previewResult">预览</button>
      <button class="primary-btn action-main" bindtap="saveResult">保存到相册</button>
    </view>
  </view>
</view>
