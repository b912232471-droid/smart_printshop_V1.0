# Copy this file to .env and replace every placeholder before production use.

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=print_shop
MYSQL_USER=print_shop
MYSQL_PASSWORD=replace-with-strong-db-password
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_PORT=6379

PRINTSHOP_DATASOURCE_URL=jdbc:mysql://mysql:3306/print_shop?serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
PRINTSHOP_DATASOURCE_USERNAME=print_shop
PRINTSHOP_DATASOURCE_PASSWORD=replace-with-strong-db-password
PRINTSHOP_JWT_SECRET=replace-with-at-least-32-random-characters
PRINTSHOP_FIELD_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
PRINTSHOP_REDIS_HOST=redis
PRINTSHOP_REDIS_PORT=6379
PRINTSHOP_REDIS_DATABASE=0
PRINTSHOP_CAPTCHA_EXPIRE_SECONDS=120
PRINTSHOP_MAIL_ENABLED=false
PRINTSHOP_MAIL_HOST=smtp.qq.com
PRINTSHOP_MAIL_PORT=465
PRINTSHOP_MAIL_USERNAME=your-qq-number@qq.com
PRINTSHOP_MAIL_AUTH_CODE=replace-with-qq-smtp-authorization-code
PRINTSHOP_MAIL_FROM=your-qq-number@qq.com
PRINTSHOP_EMAIL_CODE_EXPIRE_SECONDS=300
PRINTSHOP_EMAIL_CODE_COOLDOWN_SECONDS=60
PRINTSHOP_EMAIL_DAILY_LIMIT=20
PRINTSHOP_REQUIRE_HTTPS=true
PRINTSHOP_ALLOWED_ORIGINS=https://your-domain.example
PRINTSHOP_UPLOAD_DIR=/data/files
PRINTSHOP_MAX_FILE_SIZE=20MB
PRINTSHOP_MAX_REQUEST_SIZE=20MB
PRINTSHOP_OPENXML_MAX_ENTRIES=2000
PRINTSHOP_OPENXML_MAX_ENTRY_UNCOMPRESSED_BYTES=20971520
PRINTSHOP_OPENXML_MAX_TOTAL_UNCOMPRESSED_BYTES=104857600
PRINTSHOP_PDF_MAX_PAGES=200
PRINTSHOP_PDF_REJECT_ENCRYPTED=true
PRINTSHOP_PDF_MAX_OBJECTS=10000
PRINTSHOP_PDF_MAX_PAGE_CONTENT_STREAMS=64
PRINTSHOP_PDF_MAX_PAGE_CONTENT_BYTES=2097152
PRINTSHOP_PDF_MAX_TOTAL_CONTENT_BYTES=20971520
PRINTSHOP_IMAGE_MAX_WIDTH=10000
PRINTSHOP_IMAGE_MAX_HEIGHT=10000
PRINTSHOP_IMAGE_MAX_PIXELS=40000000
PRINTSHOP_IMAGE_MODERATION_ENABLED=false
PRINTSHOP_IMAGE_MODERATION_ENDPOINT_URL=
PRINTSHOP_IMAGE_MODERATION_API_KEY=
PRINTSHOP_IMAGE_MODERATION_TIMEOUT_MS=5000
PRINTSHOP_IMAGE_MODERATION_FAIL_CLOSED=true
PRINTSHOP_LOGIN_MAX_FAILURES=5
PRINTSHOP_LOGIN_LOCK_SECONDS=900
PRINTSHOP_LOGIN_WINDOW_SECONDS=900
PRINTSHOP_TRUST_FORWARDED_HEADERS=false
PRINTSHOP_SECURITY_ALERT_ENABLED=true
PRINTSHOP_SECURITY_ALERT_WEBHOOK_URL=
PRINTSHOP_RATE_LIMIT_ENABLED=true
PRINTSHOP_RATE_LIMIT_REQUESTS=240
PRINTSHOP_RATE_LIMIT_WINDOW_SECONDS=60
PRINTSHOP_BOOTSTRAP_ADMIN_ENABLED=false
PRINTSHOP_BOOTSTRAP_ADMIN_USERNAME=
PRINTSHOP_BOOTSTRAP_ADMIN_PASSWORD=
PRINTSHOP_BOOTSTRAP_ADMIN_REAL_NAME=
PRINTSHOP_BOOTSTRAP_ADMIN_PHONE=
PRINTSHOP_BOOTSTRAP_ADMIN_EMAIL=
PRINTSHOP_VIRUS_SCAN_ENABLED=true
PRINTSHOP_VIRUS_SCAN_HOST=clamav
PRINTSHOP_VIRUS_SCAN_PORT=3310
PRINTSHOP_VIRUS_SCAN_TIMEOUT_MS=5000
PRINTSHOP_VIRUS_SCAN_FAIL_CLOSED=true



NACOS_ENABLED=true
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

GATEWAY_PORT=8080
PRINT_SERVICE_URI=lb://print-service
PHOTO_SERVICE_URI=lb://photo-service
PHOTO_MAX_UPLOAD_BYTES=8388608
PHOTO_MAX_IMAGE_WIDTH=8000
PHOTO_MAX_IMAGE_HEIGHT=8000
PHOTO_MAX_IMAGE_PIXELS=24000000
PHOTO_MODEL_PATH=pretrained/modnet.onnx
SCHEDULE_SERVICE_URI=lb://schedule-service
CHAT_SERVICE_URI=lb://chat-service
CHAT_DATABASE=chatbot_db
CHAT_DATABASE_URL=mysql+pymysql://print_shop:replace-with-strong-db-password@mysql:3306/chatbot_db?charset=utf8mb4
CHAT_AUTH_ENABLED=true
CHAT_JWT_SECRET=replace-with-at-least-32-random-characters
CHAT_SEED_DEFAULTS=true
CHAT_QDRANT_URL=http://qdrant:6333
CHAT_QDRANT_COLLECTION=printshop_knowledge
CHAT_VECTOR_ENABLED=true
CHAT_VECTOR_REQUIRED=true
CHAT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHAT_MAX_MARKDOWN_BYTES=5242880
CHAT_CHUNK_SIZE=900
CHAT_CHUNK_OVERLAP=120
CHAT_INGESTION_INLINE=false
CHAT_INTERNAL_GATEWAY_URL=http://gateway:8080
CHAT_TOOL_TIMEOUT_SECONDS=8
CHAT_AGENT_MAX_STEPS=4
CHAT_HISTORY_LIMIT=12
# AI 客服 LLM 接入（通用 OpenAI 兼容 chat/completions；当前为 TokenHub 聚合平台混元 hy3；旧 DEEPSEEK_* 变量名仍被兼容读取）
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
CHAT_LLM_MODEL=hy3
CHAT_LLM_TIMEOUT_SECONDS=25
SCHEDULE_DATABASE=schedule_db
SCHEDULE_DATASOURCE_URL=jdbc:mysql://mysql:3306/schedule_db?serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SCHEDULE_DATASOURCE_USERNAME=print_shop
SCHEDULE_DATASOURCE_PASSWORD=replace-with-strong-db-password
SCHEDULE_FIELD_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SCHEDULE_AUTH_ENABLED=true
SCHEDULE_JWT_SECRET=replace-with-at-least-32-random-characters
SCHEDULE_SYNC_MOCK_ENABLED=false
SCHEDULE_SYNC_ZFSOFT_ENABLED=false
SCHEDULE_SYNC_ZFSOFT_BASE_URL=
SCHEDULE_SYNC_ZFSOFT_GNMKDM=N253508
SCHEDULE_SYNC_ZFSOFT_TIMEOUT_MS=15000
SCHEDULE_SYNC_HTTP_ENABLED=false
SCHEDULE_SYNC_HTTP_ENDPOINT_URL=
SCHEDULE_SYNC_HTTP_BEARER_TOKEN=
SCHEDULE_SYNC_HTTP_TIMEOUT_MS=10000
SCHEDULE_ACTUATOR_EXPOSURE=health,info
GATEWAY_ACTUATOR_EXPOSURE=health,info
GATEWAY_ALLOWED_ORIGINS=https://your-domain.example
GATEWAY_AUTH_ENABLED=true
GATEWAY_JWT_SECRET=replace-with-at-least-32-random-characters
# Legacy print-core compatibility route. Keep /api/** until old clients are gone;
# then set a narrow allowlist such as /api/public-files/** or a disabled sentinel path.
GATEWAY_PRINT_COMPAT_PATHS=/api/**
GATEWAY_TRUST_FORWARDED_HEADERS=false
GATEWAY_REQUEST_LOG_ENABLED=true
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REQUESTS=600
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_CB_SLIDING_WINDOW_SIZE=20
GATEWAY_CB_MINIMUM_CALLS=10
GATEWAY_CB_FAILURE_RATE_THRESHOLD=50
GATEWAY_CB_WAIT_DURATION=30s
GATEWAY_CB_HALF_OPEN_CALLS=3
GATEWAY_CB_TIMEOUT=10s
# Optional per-service CircuitBreaker overrides. Leave commented to inherit GATEWAY_CB_*.
# GATEWAY_PRINT_CB_SLIDING_WINDOW_SIZE=20
# GATEWAY_PRINT_CB_MINIMUM_CALLS=10
# GATEWAY_PRINT_CB_FAILURE_RATE_THRESHOLD=50
# GATEWAY_PRINT_CB_WAIT_DURATION=30s
# GATEWAY_PRINT_CB_HALF_OPEN_CALLS=3
GATEWAY_PRINT_CB_TIMEOUT=90s
# GATEWAY_PHOTO_CB_SLIDING_WINDOW_SIZE=20
# GATEWAY_PHOTO_CB_MINIMUM_CALLS=10
# GATEWAY_PHOTO_CB_FAILURE_RATE_THRESHOLD=50
# GATEWAY_PHOTO_CB_WAIT_DURATION=30s
# GATEWAY_PHOTO_CB_HALF_OPEN_CALLS=3
GATEWAY_PHOTO_CB_TIMEOUT=90s
# GATEWAY_SCHEDULE_CB_SLIDING_WINDOW_SIZE=20
# GATEWAY_SCHEDULE_CB_MINIMUM_CALLS=10
# GATEWAY_SCHEDULE_CB_FAILURE_RATE_THRESHOLD=50
# GATEWAY_SCHEDULE_CB_WAIT_DURATION=30s
# GATEWAY_SCHEDULE_CB_HALF_OPEN_CALLS=3
# GATEWAY_SCHEDULE_CB_TIMEOUT=20s
# GATEWAY_CHAT_CB_SLIDING_WINDOW_SIZE=20
# GATEWAY_CHAT_CB_MINIMUM_CALLS=10
# GATEWAY_CHAT_CB_FAILURE_RATE_THRESHOLD=50
# GATEWAY_CHAT_CB_WAIT_DURATION=30s
# GATEWAY_CHAT_CB_HALF_OPEN_CALLS=3
GATEWAY_CHAT_CB_TIMEOUT=90s

NGINX_SERVER_NAME=your-domain.example
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=25m
NGINX_CERT_DIR=./nginx/certs
NGINX_CERTIFICATE=/etc/nginx/certs/fullchain.pem
NGINX_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem

# 百度 OCR（OCR 图片转 Word/PDF；生产环境填写，不要提交真实密钥）
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/accurate_basic
BAIDU_OCR_TIMEOUT_MS=60000
BAIDU_OCR_MAX_FILE_SIZE_MB=4
# Linux 可配置为系统中文字体，例如 /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
BAIDU_OCR_PDF_FONT_PATH=

# AI 图片生成（阶跃星辰 StepFun，0.02 元/张；未配 Key 时接口返回 503，不要提交真实密钥）
# 当前模型 step-image-edit-2 官方公告 2026-10-10 下线，届时在 photo-service IMAGE_MODEL_CATALOG 换模型即可
# 支持尺寸（平台按 宽x高 传入，适配层自动换轴）：1024x1024 / 768x1360 / 1360x768 / 896x1184 / 1184x896
IMAGE_API_BASE_URL=https://api.stepfun.com/v1
IMAGE_API_KEY=
IMAGE_API_TIMEOUT_SECONDS=60
IMAGE_MODEL=step-image-edit-2
# 提示词润色 LLM（print-service；留空时自动回落到 CHAT_LLM_API_KEY，与 AI 客服共用同一聚合平台）
PRINTSHOP_PHOTO_BASE_URL=http://photo-service:8091
PRINTSHOP_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
PRINTSHOP_LLM_MODEL=hy3
# 生成图存储目录（留空跟随 PRINTSHOP_UPLOAD_DIR 的 imagegen 子目录）；提示词黑名单（逗号分隔）
PRINTSHOP_IMAGEGEN_STORAGE_DIR=
PRINTSHOP_IMAGEGEN_PROMPT_BLOCKLIST=
